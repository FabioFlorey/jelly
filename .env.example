# jelly MCP bearer token for local/manual clients.
# Generate with: openssl rand -hex 32
JELLY_MCP_TOKEN=

# OAuth owner/bootstrap secret. Used for paired owner sessions and private DCR.
# Generate with: openssl rand -hex 32
JELLY_BOOTSTRAP_SECRET=

# OAuth consent: browser | paired
JELLY_OAUTH_CONSENT_MODE=browser

# Required only in browser consent mode.
JELLY_OAUTH_PASSWORD=

# Allow unauthenticated Dynamic Client Registration only for ChatGPT callback URLs.
JELLY_OAUTH_PUBLIC_CHATGPT_DCR=false

# Hosting: local | quick-tunnel | nip-io | cloudflare-fixed
JELLY_HOSTING_MODE=local

# Local listen address.
# JELLY_MCP_ADDR=127.0.0.1:8787

# Browser service startup timeout in seconds.
# JELLY_BROWSER_STARTUP_TIMEOUT_SECS=30

# Maximum wait for one CDP response in seconds.
# JELLY_CDP_TIMEOUT_SECS=60

# MCP Agent API surface. Empty/unknown values fail MCP startup.
# Accepted canonical values: large-surface | small-surface.
# Default when unset: small-surface.
# small-surface: publishes browser-schema/browser-call/browser-events + system tools.
# large-surface: publishes individual browser primitives + system tools.
# JELLY_MCP_SURFACE=small-surface

# Browser-performance / rollback diagnostics. Defaults are enabled for the
# persistent MCP session and page runtime; leave these commented for normal use.
# JELLY_MCP_PERSISTENT_SESSION=1
# Development-only fallback: when an MCP system-tool binary is missing beside jelly-mcp,
# allow spawning it via `cargo run` from the source checkout. Disabled by default so release
# servers cannot silently execute source-tree code that differs from the installed build.
# JELLY_MCP_ALLOW_CARGO_FALLBACK=0
# browser-events subscriptions are runtime-scoped to this persistent MCP BrowserSession;
# setting the flag to 0 disables browser-events rather than creating non-durable subscriptions.
# Privileged raw CDP escape hatch for both browser surfaces. Disabled by default.
# small-surface exposes raw methods through browser-call; large-surface exposes raw-only cdp-call.
# When enabled, authenticated clients can issue syntactically valid target/browser CDP
# commands that bypass Jelly semantic-operation policy; see SECURITY.md and docs/MCP.md.
# Process-wide: changes require restarting the MCP process; current OAuth uses one `jelly` scope.
# Accepted values: 1,true,on or 0,false,off.
# JELLY_MCP_RAW_CDP=0
# JELLY_PAGE_RUNTIME=1
# JELLY_SNAPSHOT_LIMIT=0
# JELLY_PERF_LOG=0

# Stable public origin for cloudflare-fixed, e.g. https://jelly.example.com
# JELLY_PUBLIC_URL=


# nip.io direct HTTPS
# Network setup: manual | auto. Auto requires upnpc or natpmpc.
JELLY_NIP_IO_NETWORK=manual
# Optional public IPv4 override; otherwise discovered through public HTTP services.
# JELLY_PUBLIC_IPV4=
# Optional hostname override; otherwise jelly-<public-ip>.nip.io is derived.
# JELLY_NIP_IO_HOSTNAME=
# Optional Caddy executable; caddy from PATH or PiLink's private binary is auto-detected.
# JELLY_CADDY_BIN=
# Local forwarded ports used by Caddy. Public 80/443 must map here.
# JELLY_NIP_IO_HTTP_PORT=8080
# JELLY_NIP_IO_HTTPS_PORT=8443

# Fixed Cloudflare named-tunnel token. Not used by quick-tunnel mode.
JELLY_CLOUDFLARE_TUNNEL_TOKEN=

# Optional cloudflared path. PiLink's private binary is auto-detected if present.
# JELLY_CLOUDFLARED_BIN=

# Telegram HITL
JELLY_TELEGRAM_BOT_TOKEN=
JELLY_TELEGRAM_CHAT_ID=
